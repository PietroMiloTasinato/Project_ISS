System sprint_0

Request request_to_load: request_to_load(ARG)
Reply retry_later: retry_later(ARG) for request_to_load
Reply rejected: rejected(ARG) for request_to_load
Reply engaged: engaged(SLOT) for request_to_load

Context ctx_cargoservice ip [host="localhost" port=8000]

QActor cargoservice context ctx_cargoservice{
	
	[#
		val Timeout = 30000L
		var Io_port_occupied = false
		var System_out_of_service = false
		var Is_engaged = false
		val NumSlot = 4
		var FreeSlot = 0
	#]
	State start initial{
		println("CARGOSERVICE | Hold size: $NumSlot") color green
	}Goto disengaged
	
	State disengaged {
		// Stop blinking led
	} Transition t0
		whenRequest request_to_load -> engaged
		// whenMsg out_of_serive -> ...
		
	State engaged{
		if [# Io_port_occupied || System_out_of_service #]{
			replyTo request_to_load with retry_later: retry_later(0)
		}
		else {
			if [# FreeSlot < NumSlot #]{
				[# val SlotName = "slot${FreeSlot++}" #]
				replyTo request_to_load with engaged:engaged($SlotName)
			} else {
				replyTo request_to_load with rejected:rejected(0)
			}
		}	
	} Goto disengaged

	
}

QActor io_port_mock context ctx_cargoservice {
	
	[# var NumTest = 0 #]
	
	State start initial{
		println("IO_PORT_MOCK | Testing cargoservice") color green
	} Goto test
	
	State test {
		request cargoservice -m request_to_load:request_to_load(0)
	}Transition t0
		whenReply engaged -> success
		whenReply rejected -> failure
		
	State success{
		println("IO_PORT_MOCK | Request number ${NumTest++} successful") color green
	} Goto test
	
	State failure{
		println("IO_PORT_MOCK | Hold full after ${NumTest} successful") color green
	}
}




